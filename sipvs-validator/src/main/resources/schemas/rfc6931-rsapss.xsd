<?xml version="1.0" encoding="UTF-8"?>
<!-- RSAPSSParams of RSASSA-PSS with parameters (http://www.w3.org/2007/05/xmldsig-more#rsa-pss). Source: RFC 6931, section 2.3.9 (https://www.rfc-editor.org/rfc/rfc6931.txt), downloaded 2026-11-18. The definitions are copied unchanged; the RFC prints them without the xs:schema element, so the xs:schema element (target namespace from the RFC, qualified local elements) and the xs:import of XML Signature were added. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:pss="http://www.w3.org/2007/05/xmldsig-more#" targetNamespace="http://www.w3.org/2007/05/xmldsig-more#" elementFormDefault="qualified">
   <xs:import namespace="http://www.w3.org/2000/09/xmldsig#"/>
   <xs:element name="RSAPSSParams" type="pss:RSAPSSParamsType">
       <xs:annotation>
           <xs:documentation>
   Top level element that can be used in xs:any namespace="#other"
   wildcard of ds:SignatureMethod content.
           </xs:documentation>
       </xs:annotation>
   </xs:element>
   <xs:complexType name="RSAPSSParamsType">
       <xs:sequence>
           <xs:element ref="ds:DigestMethod" minOccurs="0"/>
           <xs:element name="MaskGenerationFunction"
              type="pss:MaskGenerationFunctionType" minOccurs="0"/>
           <xs:element name="SaltLength" type="xs:int"
              minOccurs="0"/>
           <xs:element name="TrailerField" type="xs:int"
              minOccurs="0"/>
       </xs:sequence>
   </xs:complexType>
   <xs:complexType name="MaskGenerationFunctionType">
       <xs:sequence>
           <xs:element ref="ds:DigestMethod" minOccurs="0"/>
       </xs:sequence>
       <xs:attribute name="Algorithm" type="xs:anyURI"
          default="http://www.w3.org/2007/05/xmldsig-more#MGF1"/>
   </xs:complexType>
</xs:schema>
